[ surface ]
set: c1[1.0e-4]
$ fundamental voxel
101 rpp  -22E-1 -18E-1  -22E-1 -18E-1  -22E-1 -18E-1
99 so 100
$ Main space
201 rpp -22E-1+c1 22E-1-c1 -22E-1+c1 22E-1-c1 -22E-1+c1 22E-1-c1

[ T - T r a c k ]
     mesh =  xyz
   x-type =    2
       nx =  100
     xmin =  -25E-1
     xmax =   25E-1
   y-type =    2
       ny =  100
     ymin =  -25E-1
     ymax =   25E-1
   z-type =    2
       nz =   11
     zmin =  -22E-1
     zmax =   22E-1
     part =  electron photon
   e-type =    1
       ne =    1
            0.0  1000.0
     unit =    1
     axis =   xy
     file = Track-Escenario.out
    title = Track - I-131 Escenario 2: Fuente uniforme + Tejido heterogeneo
    gshow =    2            # 2: bnd+mat, para distinguir tiroides/insercion
   epsout =    1

[ T-Deposit ]
  mesh = xyz
  x-type = 2
  nx = 11
  xmin = -22E-1
  xmax =  22.0E-1
  y-type = 2
  ny = 11
  ymin = -22.0E-1
  ymax = 22.0E-1
  z-type = 2
  nz = 11
  zmin = -22.0E-1
  zmax =  22.0E-1
  axis = xy
  output = dose
  unit = 0
  title = Dose - total (I-131 Escenario 2: Fuente uniforme + Tejido heterogeneo)
  file = robot-deposit-xz.out
  gshow = 2
  epsout = 1
  material = all
  part = all

[ T-Deposit ]
  mesh = xyz
  x-type = 2
  nx = 11
  xmin = -22E-1
  xmax =  22.0E-1
  y-type = 2
  ny = 11
  ymin = -22.0E-1
  ymax = 22.0E-1
  z-type = 2
  nz = 11
  zmin = -22.0E-1
  zmax =  22.0E-1
  axis = xy
  output = dose
  unit = 0
  title = Dose - electrones (beta)
  file = deposit_electron.out
  gshow = 1
  epsout = 0
  material = all
  part = electron

[ T-Deposit ]
  mesh = xyz
  x-type = 2
  nx = 11
  xmin = -22E-1
  xmax =  22.0E-1
  y-type = 2
  ny = 11
  ymin = -22.0E-1
  ymax = 22.0E-1
  z-type = 2
  nz = 11
  zmin = -22.0E-1
  zmax =  22.0E-1
  axis = xy
  output = dose
  unit = 0
  title = Dose - fotones (gamma)
  file = deposit_photon.out
  gshow = 1
  epsout = 0
  material = all
  part = photon

[ T - 3Dshow ]
    title = [t-3dshow: icnt = 11]
     file = robot-3D.out
       x0 =  0.000000
       y0 =  0.000000
       z0 =  0.000000
    e-the =  60.0000
    e-phi =  290.00000
    l-the =  40.0000
    l-phi =  310.00000
    w-wdt =  60.0000
    w-hgt =  60.00000
    w-dst =  60.00000
    w-mnw =  50
    w-mnh =  50
   heaven =    z
    w-ang =  0.000000
   bright = 1.0000000
     dark = 0.2000000
    resol =   20
    width = 0.1000000
    r-out =  50000.00
   output =    3
material = -1
           1     $ oculta el material 1 (tiroides): la queda "transparente"
                 $ para ver directo la insercion (material 2) enterrada
                 $ adentro, sin tener que pasar pagina por pagina en Sumatra
     line =    0
   shadow =    1
   epsout =    1

[end]
