$OMP = 8
[title]
I-131 Escenario 2: Fuente uniforme + Tejido heterogeneo

[parameters]
 icntl    =    0    # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =       1E04    # (D=10) number of particles per one batch
 maxbch   =       50  # (D=10) number of batches
 file(6)  = phits.out       # (D=phits.out) general output file name
 negs = 1
 e-mode = 2
 emin(12) = 0.001
 emin(13) = 0.001
 emin(14) = 0.001

[source]
$ ---------------------------------------------------------------------------
$ Escenario 2 de 4 (anteproyecto): fuente UNIFORME (igual que Escenario 1)
$ + tejido HETEROGENEO (insercion de alto contraste dentro de cada zona
$ activa, ver [Cell] mas abajo). Aisla el efecto de la heterogeneidad de
$ TEJIDO solo (sin heterogeneidad de fuente).
$ ---------------------------------------------------------------------------
   totfact = 2.0
     <source>  = 1.00
     s-type =  22             # xyz-mesh distribution source
     proj =   electron      # kind of incident particle
      dir =  all           # isotropico
       e-type = 28
       ni = 1   # 1 fuente
       I-131 1E6
       norm = 1   # /source
       dtime = 0
       isbias = 2   # misma cantidad de historias en cada voxel activo,
                     # ajustando el peso estadistico (ver manual s-type=22)
     mesh =  xyz
   x-type =    2
       nx =   11
     xmin = -22E-1
     xmax =  22E-1
   y-type =    2
       ny =   -11
     ymin = -22E-1
     ymax =  22E-1
   z-type =    2
       nz =   11
     zmin = -22E-1
     zmax =  22E-1
$ tabla de intensidades I_ijk: 11 capas (z, de zmin a zmax), cada una
$ de 11 filas (y, de ymin a ymax) por 11 columnas (x, de xmin a xmax)
